# Normalize line endings. The scrub hooks are shell scripts invoked by bash;
# a CRLF checkout on Windows breaks them with "\r: command not found", which
# fails open-looking (hook errors, commit proceeds if --no-verify is reflexive).
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf

# Binary — never diff, never normalize. Pinned superset (supported + rejected
# raster) derived from scripts/image-formats.sh: if a rejected raster ever
# lands through a bypass, normalization must not alter its bytes while it is
# investigated and removed. Checked by scripts/check-image-format-parity.py.
*.png   binary
*.jpg   binary
*.jpeg   binary
*.webp   binary
*.gif   binary
*.bmp   binary
*.tif   binary
*.tiff   binary
*.avif   binary
*.heic   binary
*.heif   binary
*.ico   binary
*.jfif   binary

